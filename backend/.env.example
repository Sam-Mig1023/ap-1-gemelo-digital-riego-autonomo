# FastAPI VRI Digital Twin Backend Configuration

# Environment
DEBUG=True
LOG_LEVEL=INFO

# Database Configuration
DATABASE_URL=postgresql+asyncpg://vri_admin:vri_secure_pass_2026@localhost:5432/vri_digital_twin
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30

# Redis Configuration
REDIS_URL=redis://localhost:6379

# Security
SECRET_KEY=your-super-secret-key-change-in-production-2026
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ML/RL Model Configuration
RL_MODEL_VERSION=PPO-VRI-DualReward-v4.2
ANOMALY_DETECTION_THRESHOLD=0.85
ANOMALY_DETECTION_METHOD=isolation_forest

# Irrigation Control
MAX_IRRIGATION_DEPTH_MM=100.0
MIN_IRRIGATION_DEPTH_MM=0.5
EXECUTION_WINDOW_BUFFER_HOURS=1

# Telemetry
TELEMETRY_BATCH_SIZE=100
TELEMETRY_RETENTION_DAYS=90

# Reports
REPORT_OUTPUT_DIR=./reports
